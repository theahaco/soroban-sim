package theahaco:soroban-sim@0.1.0;

/// A network session: many signed transactions applied in order over a fork
/// of a real network, each seeing every earlier write, with fees charged, the
/// clock moving and every signature verified. It answers the same stellar-rpc
/// and fork_* JSON-RPC methods `soroban-sim serve` does (docs/rpc-facade.md),
/// so a page's stellar-sdk can use it as its RPC server.
///
/// The base ledger is read lazily, by the caller: a call that needs base
/// entries it has not provided yet is undone and returns `needs-state` with
/// their keys. Fetch them (RPC `getLedgerEntries`), `provide` them, and make
/// the same call again.
interface network-session {
    // A base ledger entry that is present. entry-xdr is stellar-xdr
    // LedgerEntry; live-until-ledger is set for ContractData/ContractCode.
    record base-entry {
        entry-xdr: list<u8>,
        live-until-ledger: option<u32>,
    }

    // One batch the caller read from the base: present entries and keys
    // proven absent, as of `served-at-ledger`.
    record base-batch {
        served-at-ledger: u32,
        entries: list<base-entry>,
        absent-keys: list<list<u8>>,
    }

    // Where the session forks: the base's last closed ledger.
    record fork-config {
        network-name: string,               // "testnet", "mainnet", an RPC URL
        network-passphrase: string,         // kept: signatures stay real
        base-description: string,           // where base entries come from, for the report
        fork-ledger: u32,
        fork-close-time: u64,
        protocol-version: u32,              // must be this host's protocol
        base-reserve: u32,
        base-fee: u32,
        header-xdr: option<list<u8>>,       // stellar-xdr LedgerHeader at the fork ledger
        seconds-per-ledger: u32,            // close-time step; 0 means the network's 5 s
        allow-real-signers: bool,           // apply envelopes a real mainnet signer signed
        served-by: string,                  // who serves the session, for the report
    }

    variant reply {
        response(option<string>),           // the JSON-RPC response (none: notifications only)
        needs-state(list<list<u8>>),        // LedgerKey XDR to fetch and provide; the call was undone
    }

    record balance-override {
        account: string,                    // G... (created if the base lacks it)
        stroops: s64,
        label: string,
    }

    record signer-override {
        account: string,                    // G...
        signer: string,                     // throwaway G... that takes over
        replace: option<string>,            // none: the master key; else the real signer's G...
        label: string,
    }

    record entry-override {
        entry-xdr: list<u8>,                // stellar-xdr LedgerEntry
        live-until-ledger: option<u32>,
        label: string,
    }

    record removal-override {
        key-xdr: list<u8>,                  // stellar-xdr LedgerKey
        label: string,
    }

    // Every override is logged; a rehearsal is only as honest as that list.
    variant ledger-override {
        set-balance(balance-override),
        add-signer(signer-override),
        set-entry(entry-override),
        remove-entry(removal-override),
    }

    // Each method's response is the JSON-RPC response of the matching
    // facade method, named in its comment.
    resource session {
        constructor(config: fork-config);
        provide: func(batch: base-batch) -> result<_, string>;
        // Any JSON-RPC 2.0 body: a call or a batch.
        rpc: func(body: string) -> result<reply, string>;
        // sendTransaction (stellar-xdr TransactionEnvelope)
        submit: func(envelope-xdr: list<u8>) -> result<reply, string>;
        // fork_advanceLedgers; seconds defaults to ledgers x seconds-per-ledger
        advance: func(ledgers: u32, seconds: option<u64>) -> result<reply, string>;
        // fork_setTime: the next ledger closes at `time`
        set-time: func(time: u64) -> result<reply, string>;
        // fork_setBalance, fork_addSigner, fork_setLedgerEntry, fork_removeLedgerEntry
        apply-override: func(change: ledger-override) -> result<reply, string>;
        // fork_snapshot; the result's `id` is what `revert` takes
        snapshot: func(label: string) -> result<reply, string>;
        // fork_revert
        revert: func(id: u32) -> result<reply, string>;
        // fork_allowRealSigners
        allow-real-signers: func(allow: bool) -> result<reply, string>;
        // fork_steps: the timeline
        steps: func() -> result<reply, string>;
        // fork_debugContext: what the time-travel debugger needs for one step
        debug-context: func(step: u32) -> result<reply, string>;
        // fork_report: the session report as JSON and Markdown
        report: func() -> result<reply, string>;
        // The caller's base RPC calls and throttled retries, for the report.
        set-rpc-counters: func(calls: u32, throttled-retries: u32);
    }
}

world simulator {
    record ledger-context {
        protocol-version: u32,
        sequence-number: u32,
        timestamp: u64,
        network-id: list<u8>,
        base-reserve: u32,
        min-temp-entry-ttl: u32,
        min-persistent-entry-ttl: u32,
        max-entry-ttl: u32,
    }

    // A ledger entry the caller KNOWS is present. entry-xdr is stellar-xdr LedgerEntry;
    // live-until-ledger MUST be set for ContractData/ContractCode (host requires a TTL).
    record ledger-entry {
        entry-xdr: list<u8>,
        live-until-ledger: option<u32>,
    }

    record request {
        host-function-xdr: list<u8>,        // stellar-xdr HostFunction (transaction XDR deferred)
        source-account-xdr: list<u8>,       // stellar-xdr AccountId
        ledger-context: ledger-context,
        ledger-entries: list<ledger-entry>, // present entries (incl. any ConfigSetting entries)
        known-absent-keys: list<list<u8>>,  // LedgerKey XDR proven absent -> Ok(None)
        base-prng-seed: list<u8>,
        enable-diagnostics: bool,
        // false (default) -> raw metered resources/fees; true -> apply
        // soroban-simulation's RPC-parity adjustment (instructions/fee padding).
        apply-rpc-adjustments: bool,
    }

    // Same as `request` but driven from a full Stellar TransactionEnvelope: the
    // host-function + source-account are extracted from the InvokeHostFunction
    // operation instead of being supplied pre-split.
    record transaction-request {
        transaction-xdr: list<u8>,          // stellar-xdr TransactionEnvelope
        ledger-context: ledger-context,
        ledger-entries: list<ledger-entry>, // present entries (incl. any ConfigSetting entries)
        known-absent-keys: list<list<u8>>,  // LedgerKey XDR proven absent -> Ok(None)
        base-prng-seed: list<u8>,
        enable-diagnostics: bool,
        // false (default) -> raw metered resources/fees; true -> apply
        // soroban-simulation's RPC-parity adjustment (instructions/fee padding).
        apply-rpc-adjustments: bool,
    }

    variant outcome {
        complete(list<u8>),                 // deterministic SSIM-encoded result (success OR contract failure encoded inline)
        needs-state(list<list<u8>>),        // LedgerKey XDR that were Unknown; refetch and rerun
    }

    // Pass 1 completed and the enforcing replay reproduced it exactly.
    record trace-complete {
        ssim: list<u8>,                     // byte-identical to what `simulate` returns
        trace: list<u8>,                    // STRC-encoded semantic trace steps
    }

    // Pass 1 completed but the trace replay could not run or diverged;
    // callers degrade to diagnostics-only over `ssim`.
    record trace-fallback {
        ssim: list<u8>,
        reason: string,
    }

    variant trace-outcome {
        complete(trace-complete),
        needs-state(list<list<u8>>),        // LedgerKey XDR that were Unknown; refetch and rerun
        trace-unavailable(trace-fallback),
    }

    export simulate: func(request: request) -> result<outcome, string>;
    export simulate-transaction: func(request: transaction-request) -> result<outcome, string>;
    export simulate-trace: func(request: request) -> result<trace-outcome, string>;
    export run-fixture: func() -> result<list<u8>, string>;
    export network-session;
}
