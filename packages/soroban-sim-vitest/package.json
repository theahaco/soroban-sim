{
  "name": "@theahaco/soroban-sim-vitest",
  "version": "0.1.0",
  "private": true,
  "description": "Vitest suites whose setup runs once and whose tests each get their own soroban-sim RPC, or a local network",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/standalone.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:local": "SOROBAN_TEST_ENV=local vitest run",
    "check": "tsc --noEmit",
    "cache:clear": "node -e \"require('node:fs').rmSync(process.env.SOROBAN_TEST_CACHE_DIR || 'node_modules/.cache/soroban-sim-vitest', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.0"
  },
  "peerDependencies": {
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
